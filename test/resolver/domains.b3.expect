// Resolved B3 program

domain Domain
{
  function F(): int
}

domain DR
{
}

domain DS(X)
{
  type Y

  function Ten(x: int, y: Y): int
    when x == 7
  {
    x + 3
  }

  function G(injective b: bool): int

  function G..b(subject: int): bool

  axiom explains G
    forall b: bool
      pattern G(b)
      G..b(G(b)) == b

  axiom explains Ten
    forall x: int, y: Y
      pattern Ten(x, y)
      x == 7 ==>
      Ten(x, y) == x + 3

  axiom explains G
    G(true) < 10
}

domain DT(X, Y)
{
  procedure OnlyBodyless(u: int, out w: int)
    ensures u <= w

  procedure Q(x: X, y: Y)
}

type Outside
