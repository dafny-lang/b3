// RUN: %b3 resolve --rprint "%s" > "%t"
// RUN: %diff "%s.expect" "%t"

type Outside

domain Domain {
  function F(): int
}

domain DR() {
}

domain DS(X) {
  type Y

  function Ten(x: int, y: Y): int
    when x == 7
  {
    x + 3
  }

  function G(injective b: bool): int
  axiom explains G
    G(true) < 10
}

domain DT(X, Y) {
  procedure OnlyBodyless(u: int, out w: int)
    ensures u <= w

  procedure Q(dt: DT, x: X, y: Y)
}
