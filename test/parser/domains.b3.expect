// B3 program

domain Domain
{
  function F(): int
}

domain DR
{
}

domain DS(X)
{
  type Y

  function Ten(x: int, y: Y): int
    when x == 7
  {
    x + 3
  }

  function G(injective b: bool): int

  axiom explains G
    G(true) < 10
}

domain DT(X, Y)
{
  procedure OnlyBodyless(u: int, out w: int)
    ensures u <= w

  procedure Q(dt: DT, x: X, y: Y)
}

type Outside

type MyDomain := Domain

type YourDomain := Domain

type DSInt := DS(int)

type DSBool := DS(bool)

type DSMyDomain := DS(MyDomain)

type DT0 := DT(int, int)

type DT1 := DT(bool, DT0)

type DT2 := DT(DT2, DT2)
