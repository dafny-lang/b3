// RUN: %b3 parse --print "%s" > "%t"
// RUN: %diff "%s.expect" "%t"

type Outside

domain Domain {
  function F(): int
}

type MyDomain := Domain
type YourDomain := Domain

domain DR() {
}

domain DS(X) {
  type Y

  function Ten(x: int, y: Y): int
    when x == 7
  {
    x + 3
  }

  function G(injective b: bool): int
  axiom explains G
    G(true) < 10
}

type DSInt := DS(int)
type DSBool := DS(bool)
type DSMyDomain := DS(MyDomain)

domain DT(X, Y) {
  procedure OnlyBodyless(u: int, out w: int)
    ensures u <= w

  procedure Q(dt: DT, x: X, y: Y)
}

type DT0 := DT(int, int)
type DT1 := DT(bool, DT0)
type DT2 := DT(DT2, DT2)
